APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
# Set to REMOTE_ADDR when deployed behind a trusted reverse proxy such as Heroku.
TRUSTED_PROXIES=
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
# Comma-separated exact Cloudinary hosts accepted by the legacy ProductMedia migration command.
MEDIA_LEGACY_CLOUDINARY_HOSTS=res.cloudinary.com
# Production local disks must be explicitly known to be durable before migration.
MEDIA_DURABLE_DISKS=
QUEUE_CONNECTION=database

CACHE_STORE=database
PAYMENT_RESERVATION_MINUTES=30
PAYMENT_EXPIRATION_BATCH_SIZE=100
PAYMENT_INITIATION_URL_MINUTES=30
PAYMENT_STATUS_URL_MINUTES=1440

PAYMOB_SECRET_KEY=
PAYMOB_PUBLIC_KEY=
PAYMOB_HMAC_SECRET=
PAYMOB_CARD_INTEGRATION_ID=
PAYMOB_WALLET_INTEGRATION_ID=
PAYMOB_API_BASE_URL=https://accept.paymob.com
PAYMOB_INTENTION_ENDPOINT=/v1/intention/
PAYMOB_UNIFIED_CHECKOUT_BASE_URL=https://accept.paymob.com/unifiedcheckout/
PAYMOB_REDIRECT_URL=
PAYMOB_WEBHOOK_URL=
PAYMOB_TIMEOUT_SECONDS=30
PAYMOB_CONNECT_TIMEOUT_SECONDS=10
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
